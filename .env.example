#################################################################
# Vantage AI — Environment Variables
# Copy this file to .env and fill in the actual API keys
#################################################################

# Daily.co API key for video call room creation
DAILY_API_KEY=your_daily_co_api_key_here

# Deepgram API key for real-time speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API key for Llama 3.3 70B agent
GROQ_API_KEY=your_groq_api_key_here

# Optional: also mirror DB writes to JSONL for debugging/demo portability
AUDIT_WRITE_JSONL_COPY=false

# Backend application runtime
APP_HOST=0.0.0.0
APP_PORT=8001
APP_RELOAD=false

# Frontend origin for email links and callback redirects
FRONTEND_BASE_URL=http://localhost:3000

# JWT configuration
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Groq models
GROQ_LLM_MODEL=llama-3.3-70b-versatile
ORCHESTRATOR_MODEL=llama-3.3-70b-versatile
EXTRACTION_MODEL=llama-3.3-70b-versatile
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CHROMA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# KYC and OTP settings
OTP_PROVIDER=noop
OTP_VALIDITY_MINUTES=10
OTP_MAX_SENDS_PER_WINDOW=3
OTP_SEND_WINDOW_MINUTES=30
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
KYC_LINK_VALIDITY_HOURS=24
DEV_EXPOSE_KYC_OTP=false
DEEPGRAM_ALLOW_BROWSER_KEY=false

# Optional demo login accounts in JSON format
DEMO_USERS_JSON={}

# Brevo SMTP settings for email delivery
BREVO_USER=your_brevo_smtp_user
BREVO_PASS=your_brevo_smtp_password
BREVO_SENDER_EMAIL=your@email.com
BREVO_SENDER_NAME=Vantage Team
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
