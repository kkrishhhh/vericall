#################################################################
# Vantage AI — Environment Variables
# Copy this file to .env and fill in the actual API keys
#################################################################

# Daily.co API key for video call room creation
DAILY_API_KEY=your_daily_co_api_key_here

# Deepgram API key for real-time speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API key for Llama 3.3 70B agent
GROQ_API_KEY=your_groq_api_key_here

# JWT configuration (required for admin login)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# Demo portal logins
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_OFFICER_USERNAME=officer
DEMO_OFFICER_PASSWORD=officer123
DEMO_MANAGER_USERNAME=manager
DEMO_MANAGER_PASSWORD=manager123

# Optional: also mirror DB writes to JSONL for debugging/demo portability
AUDIT_WRITE_JSONL_COPY=false
